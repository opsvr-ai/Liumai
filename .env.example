# =============================================================================
# 六脉 (Liumai) 环境变量模板
# =============================================================================
# 复制此文件为 .env 并根据实际环境配置:
#   cp .env.example .env
# =============================================================================

# ----- 数据库 -----
# PostgreSQL 连接信息（平台后端）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=liumai
DB_USER=liumai
DB_PASSWORD=liumai_dev

# ----- 企业微信（WeCom）-----
# 自建应用凭证（用于创建群聊、发送消息）
WECOM_CORP_ID=your_corp_id
WECOM_CORP_SECRET=your_corp_secret
WECOM_AGENT_ID=your_agent_id

# Bot 凭证（用于群内 @bot 交互）
WECOM_BOT_ID=your_bot_id
WECOM_SECRET=your_bot_secret

# ----- LLM 配置 -----
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-xxx
# 可选：使用兼容 API 的代理地址（如 Azure OpenAI / 私有部署）
OPENAI_BASE_URL=

# ----- 集中监控平台 -----
MONITORING_API_URL=http://monitoring.internal:9090
MONITORING_API_TOKEN=your_monitoring_token

# ----- 日志易 -----
RIZHIYI_API_URL=http://rizhiyi.internal:8080
RIZHIYI_API_TOKEN=your_rizhiyi_token

# ----- ClickHouse -----
CLICKHOUSE_HOST=clickhouse.internal
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_clickhouse_password
CLICKHOUSE_DATABASE=liumai

# ----- Hermes API Server -----
# Hermes 内置的 OpenAI 兼容 API Server（端口 8642）
HERMES_GATEWAY_URL=http://<windows_host_ip>:8642/v1
HERMES_API_KEY=your_hermes_api_key

# ----- RCA 技能配置 -----
RCA_MAX_CONCURRENCY=5
RCA_DEFAULT_TIME_WINDOW=30m
