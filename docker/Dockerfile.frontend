# ============================================================
# 六脉 (Liumai) — React frontend (multi-stage)
# ============================================================
# Build:  docker build -t liumai-frontend -f docker/Dockerfile.frontend .
# Run:    docker compose up -d frontend
# ============================================================

# ---- Stage 1: Build ----
FROM node:22-alpine AS builder

WORKDIR /app

# Leverage Docker layer caching: install deps before copying source
COPY .npmrc ./
COPY package.json package-lock.json ./
RUN npm ci && npm cache clean --force

# Copy only what's needed for the Vite build
COPY tsconfig.json tsconfig.app.json vite.config.ts index.html ./
COPY src/ ./src/
COPY public/ ./public/
COPY components.json ./
RUN npm run build

# ---- Stage 2: Serve via nginx ----
FROM nginx:alpine

LABEL org.opencontainers.image.title="六脉 Frontend"
LABEL org.opencontainers.image.description="RCA fault delimitation dashboard UI"

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q --spider http://localhost:80/ || exit 1

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
